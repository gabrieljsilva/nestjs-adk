{
	"name": "@nestjs-adk/openai",
	"version": "1.0.0",
	"description": "OpenAI model adapter for nestjs-adk: the official SDK with a configurable baseURL, covering every OpenAI compatible API.",
	"license": "MIT",
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"prebuild": "rimraf -g dist",
		"build": "rollup -c"
	},
	"dependencies": {
		"openai": "^6.9.0"
	},
	"peerDependencies": {
		"@nestjs-adk/core": "^1.0.0",
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0"
	},
	"devDependencies": {
		"@nestjs-adk/core": "^1.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gabrieljsilva/nestjs-adk.git",
		"directory": "packages/openai"
	},
	"homepage": "https://github.com/gabrieljsilva/nestjs-adk#readme",
	"bugs": {
		"url": "https://github.com/gabrieljsilva/nestjs-adk/issues"
	}
}
