{
	"name": "@nestjs-adk/google",
	"version": "1.0.0",
	"description": "Google ADK engine adapter for @nestjs-adk/core — translates decorators into native LlmAgent/FunctionTool at runtime.",
	"license": "MIT",
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"prebuild": "rimraf -g dist",
		"build": "rollup -c"
	},
	"dependencies": {
		"@google/adk": "^1.4.0",
		"adk-llm-bridge": "^0.5.3"
	},
	"peerDependencies": {
		"@nestjs-adk/core": "^1.0.0",
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"reflect-metadata": "^0.1.13 || ^0.2.0",
		"zod": "^3.23.0 || ^4.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@nestjs-adk/core": "^1.0.0",
		"@nestjs-adk/testing": "^1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gabrieljsilva/nestjs-adk.git",
		"directory": "packages/google"
	},
	"homepage": "https://github.com/gabrieljsilva/nestjs-adk#readme",
	"bugs": {
		"url": "https://github.com/gabrieljsilva/nestjs-adk/issues"
	}
}
