{
	"name": "@nestjs-adk/testing",
	"version": "1.0.0",
	"description": "Testing utilities for nestjs-adk: TestAgent, scripted engine/models, Vitest matchers and LLM-as-judge.",
	"license": "MIT",
	"sideEffects": ["./dist/matchers.mjs", "./dist/matchers.cjs"],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./matchers": {
			"types": "./dist/matchers.d.ts",
			"import": "./dist/matchers.mjs",
			"require": "./dist/matchers.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"prebuild": "rimraf -g dist",
		"build": "rollup -c"
	},
	"peerDependencies": {
		"@nestjs-adk/core": "^1.0.0",
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"@nestjs/testing": "^10.0.0 || ^11.0.0",
		"vitest": ">=2.0.0",
		"zod": "^3.23.0 || ^4.0.0"
	},
	"devDependencies": {
		"@nestjs-adk/core": "^1.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"typesVersions": {
		"*": {
			"matchers": ["./dist/matchers.d.ts"]
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gabrieljsilva/nestjs-adk.git",
		"directory": "packages/testing"
	},
	"homepage": "https://github.com/gabrieljsilva/nestjs-adk#readme",
	"bugs": {
		"url": "https://github.com/gabrieljsilva/nestjs-adk/issues"
	}
}
